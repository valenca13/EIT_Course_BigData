# Transport mode choice
modes <- c("car", "PT", "walking", "cycling") # you can use "=" or "<-"
# Number of trips
Trips = c(200, 50, 300, 150) # Be careful with uppercase letters.
# Trip Origin
origin <- c("Home", "Home", "School", "Grocery")
# Trip Destination
destination <- c("Work", "University", "Park", "Home")
table_example = data.frame(modes, Trips, origin, destination)

dplyr::filter(!is.na(amenity), amenity != "loading_dock")
library(osmextract)
OSM_Sydney = oe_get_network(place = "Sydney")
par(mar = rep(0.1, 4))
plot(sf::st_geometry(OSM_Sydney))

library(ggspatial)
ggplot() +
annotation_map_tile(type = "osm", zoom = 13) +   # OSM basemap
geom_sf(data = amenities_data$osm_points, aes(color = amenity), size = 2) +
theme_minimal() +
labs(
title = "Amenities in Sydney",
color = "Amenity Type"
) +
theme(
legend.position = "bottom",
panel.background = element_rect(fill = "white", colour = NA)
)
OSM_Sydney = oe_get_network(place = "Sydney") # it will geocode the place
par(mar = rep(0.1, 4))
plot(sf::st_geometry(OSM_Sydney))
table(is.na(OSM_Sydney$highway))
unique(OSM_Sydney$highway)
Sydney_main_roads = OSM_Sydney %>%
filter(highway %in% c("motorway", "motorway_link", "primary", "primary_link", "secondary","secondary_link", "trunk", "trunk_link"))
names(OSM_Sydney)
Sydney_main_roads <- Sydney_main_roads[,-c(4:12)]
par(mar = rep(0.1, 4))
plot(sf::st_geometry(Sydney_main_roads))
ggplot() +
geom_sf(data = Sydney_main_roads, color = "grey80", size = 0.3) +
geom_sf(data = amenities_data$osm_points, aes(color = amenity), size = 2) +
theme_minimal() +
labs(title = "Amenities in Sydney", color = "Amenity Type") +
theme(legend.position = "bottom")
ggplot() +
geom_sf(data = Sydney_main_roads, color = "grey80", size = 0.3) +
geom_sf(data = amenities_data$osm_points, aes(color = amenity), size = 1) +
theme_minimal() +
labs(title = "Amenities in Sydney", color = "Amenity Type") +
theme(legend.position = "bottom")
ggplot() +
geom_sf(data = Sydney_main_roads, color = "grey80", size = 1) +
geom_sf(data = amenities_data$osm_points, aes(color = amenity), size = 1) +
theme_minimal() +
labs(title = "Amenities in Sydney", color = "Amenity Type") +
theme(legend.position = "bottom")
ggplot() +
geom_sf(data = Sydney_main_roads, color = "black", size = 0.4) +
geom_sf(data = amenities_data$osm_points, aes(color = amenity), size = 1) +
theme_minimal() +
labs(title = "Amenities in Sydney", color = "Amenity Type") +
theme(legend.position = "bottom")
